<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <RootNamespace>DinkToPdf</RootNamespace>
    <AssemblyName>SelectPdf.Compat.DinkToPdf</AssemblyName>
    <PackageId>SelectPdf.Compat.DinkToPdf</PackageId>
    <Title>Free drop-in replacement for DinkToPdf (Chromium, Linux/Docker/ARM64)</Title>
    <Description>Free drop-in replacement for DinkToPdf. Same API (IConverter, SynchronizedConverter, HtmlToPdfDocument, GlobalSettings, ObjectSettings), rendered by Chromium through the free SelectPdf Community Edition instead of wkhtmltopdf. Windows, Linux x64/ARM64, macOS Apple Silicon, Docker; no libwkhtmltox files. Up to 5 pages per document. Not affiliated with DinkToPdf.</Description>
    <PackageTags>dinktopdf;dinktopdf-alternative;wkhtmltopdf;wkhtmltopdf-alternative;wkhtmltox;html-to-pdf;htmltopdf;pdf;chromium;linux;docker;arm64;free;selectpdf</PackageTags>
  </PropertyGroup>
</Project>
