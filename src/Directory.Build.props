<Project>
  <!-- shared by both compatibility packages -->
  <PropertyGroup>
    <TargetFrameworks>netstandard2.0;net8.0</TargetFrameworks>
    <LangVersion>latest</LangVersion>
    <Nullable>disable</Nullable>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <NoWarn>$(NoWarn);CS1591</NoWarn>
    <Version>1.0.0</Version>
    <Authors>SelectPdf</Authors>
    <Company>Outside Software SRL</Company>
    <Product>SelectPdf</Product>
    <PackageProjectUrl>https://selectpdf.com/pdf-library-cross-platform/</PackageProjectUrl>
    <RepositoryUrl>https://github.com/selectpdf/selectpdf-compat-wkhtmltopdf</RepositoryUrl>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageReadmeFile>README.md</PackageReadmeFile>
  </PropertyGroup>
  <ItemGroup>
    <!-- free Community Edition engine: HTML to PDF, up to 5 pages per document -->
    <PackageReference Include="SelectPdf.HtmlToPdf.Universal" Version="26.4.0" />
    <Compile Include="$(MSBuildThisFileDirectory)Shared/**/*.cs" />
    <None Include="README.md" Pack="true" PackagePath="/" />
    <None Include="$(MSBuildThisFileDirectory)../THIRD-PARTY-DinkToPdf-LICENSE.txt" Pack="true" PackagePath="/" />
    <InternalsVisibleTo Include="$(AssemblyName).Tests" />
  </ItemGroup>
</Project>
