<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <DefineConstants>$(DefineConstants);WKHTMLTOPDFDOTNET</DefineConstants>
    <RootNamespace>WkHtmlToPdfDotNet</RootNamespace>
    <AssemblyName>SelectPdf.Compat.WkHtmlToPdfDotNet</AssemblyName>
    <PackageId>SelectPdf.Compat.WkHtmlToPdfDotNet</PackageId>
    <Title>Free Haukcode.WkHtmlToPdfDotNet replacement with the same API (Chromium, Linux/Docker/ARM64)</Title>
    <Description>A free replacement for Haukcode.WkHtmlToPdfDotNet that keeps its API (IConverter, SynchronizedConverter, HtmlToPdfDocument, GlobalSettings, ObjectSettings, CoverSettings), rendered by Chromium through the free SelectPdf Community Edition instead of wkhtmltopdf. Content is scaled the way wkhtmltopdf scaled it. Windows, Linux x64/ARM64, macOS on Apple Silicon, Docker; no wkhtmltox libraries or apt-get. Up to 5 pages per document; SelectPdf.Compat.WkHtmlToPdfDotNet.Licensed has no page limit. Not affiliated with WkHtmlToPdf-DotNet.</Description>
    <PackageTags>wkhtmltopdfdotnet;haukcode;wkhtmltopdf;wkhtmltopdf-alternative;dinktopdf-alternative;wkhtmltox;html-to-pdf;htmltopdf;pdf;chromium;linux;docker;arm64;free;selectpdf</PackageTags>
  </PropertyGroup>
</Project>
